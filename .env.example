# Mock Server de Postman publicado por el equipo de backend (colección "MultiCine Riwi Backend API v1").
VITE_API_BASE_URL=https://0acd4ae3-b876-4834-9a3f-7adce0625778.mock.pstmn.io/api/v1
VITE_API_TIMEOUT_MS=15000
# Fuerza los datos de respaldo locales sin llamar a la API. Solo para desarrollo:
# permite ejercitar estados que el mock server no expone (ciudad sin cines activos, lista vacía).
# Con `false`, el respaldo entra solo si la API falla por red o 5xx.
VITE_ENABLE_MOCKS=false
